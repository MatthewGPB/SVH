---
const {
  title = 'South Village — Rebuilding the near south side of Indianapolis',
  description = 'A neighborhood-scale development program on the Madison Avenue corridor in Indianapolis, timed to $47 million of funded city infrastructure.'
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content="/images/hero.jpg" />
<meta property="og:type" content="website" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Libre+Caslon+Display&family=Libre+Caslon+Text:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet" />
</head>
<body>
<slot />
</body>
</html>

<style is:global>
:root{
  --spruce:#242B25;
  --pine:#2E372F;
  --bone:#ECEAE1;
  --paper:#F1EFE8;
  --brick:#8A3D2C;
  --stone:#A8A79A;
  --ink:#26261F;
  --maxw:1060px;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  font-family:'Libre Caslon Text', Georgia, serif;
  background:var(--paper);
  color:var(--ink);
  font-size:17px;
  line-height:1.72;
  -webkit-font-smoothing:antialiased;
}
h1,h2,h3{font-family:'Libre Caslon Display', 'Libre Caslon Text', Georgia, serif;font-weight:400;line-height:1.12}
img{display:block;max-width:100%}
a{color:inherit}
.wrap{max-width:var(--maxw);margin:0 auto;padding:0 clamp(20px,5vw,56px)}

/* Nav */
nav{
  position:absolute;top:0;left:0;right:0;z-index:10;
  display:flex;justify-content:space-between;align-items:baseline;
  padding:28px clamp(20px,5vw,56px);
  color:var(--bone);
}
nav .mark{font-family:'Libre Caslon Display',serif;font-size:1.25rem;letter-spacing:.01em;text-decoration:none}
nav .links{display:flex;gap:28px;font-size:.85rem}
nav .links a{text-decoration:none;color:var(--stone)}
nav .links a:hover{color:var(--bone)}
@media(max-width:700px){nav .links{display:none}}

/* Hero */
header{
  background:var(--spruce);color:var(--bone);
  padding:calc(96px + 8vh) 0 0;
}
.hero-inner{max-width:var(--maxw);margin:0 auto;padding:0 clamp(20px,5vw,56px) 9vh}
.hero-inner p.intro{font-style:italic;color:var(--stone);margin-bottom:2.2rem;font-size:1.02rem}
h1{
  font-size:clamp(2.5rem,6.2vw,4.6rem);
  max-width:19ch;
  letter-spacing:-.005em;
}
.hero-inner .sub{
  margin-top:2.4rem;max-width:52ch;font-size:1.08rem;color:#CFCEC2;
}
.hero-photo{position:relative}
.hero-photo img{width:100%;height:min(72vh,640px);object-fit:cover;object-position:center 62%}
.hero-photo figcaption{
  position:absolute;right:clamp(20px,5vw,56px);bottom:18px;
  font-size:.78rem;font-style:italic;color:rgba(255,255,255,.85);
  text-shadow:0 1px 8px rgba(0,0,0,.5);
}

/* Sections */
section{padding:clamp(64px,10vh,110px) 0}
.kicker{
  font-style:italic;color:var(--brick);font-size:1rem;margin-bottom:1.1rem;
}
h2{font-size:clamp(1.9rem,3.6vw,2.7rem);max-width:24ch;margin-bottom:1.6rem}
.rule{width:56px;height:2px;background:var(--brick);margin:0 0 2.4rem}
.cols{display:grid;grid-template-columns:1fr 1fr;gap:clamp(28px,5vw,64px)}
@media(max-width:820px){.cols{grid-template-columns:1fr}}
.cols p+p{margin-top:1.1rem}
p+p{margin-top:1.1rem}

.figures{
  margin-top:3.4rem;display:grid;grid-template-columns:repeat(3,1fr);gap:2px;background:#D9D6CA;
  border-top:1px solid #D9D6CA;border-bottom:1px solid #D9D6CA;
}
@media(max-width:820px){.figures{grid-template-columns:1fr}}
.figures div{background:var(--paper);padding:26px 26px 30px}
.figures .n{font-family:'Libre Caslon Display',serif;font-size:2.2rem;line-height:1;margin-bottom:.55rem}
.figures .d{font-size:.9rem;color:#5D5C52;max-width:26ch}

/* Program */
.dark{background:var(--spruce);color:var(--bone)}
.dark .kicker{color:#C77E5F}
.dark h2{color:var(--bone)}
.dark .rule{background:#C77E5F}
.phases{margin-top:1rem;border-top:1px solid #3B453C}
.phase{
  display:grid;grid-template-columns:150px 1fr;gap:clamp(20px,4vw,48px);
  padding:38px 0;border-bottom:1px solid #3B453C;
}
@media(max-width:700px){.phase{grid-template-columns:1fr;gap:10px;padding:30px 0}}
.phase .tag{font-family:'Libre Caslon Display',serif;font-size:1.35rem;color:#C77E5F}
.phase h3{font-size:1.3rem;margin-bottom:.7rem;color:var(--bone)}
.phase p{color:#C8C7BB;font-size:1rem;max-width:62ch}

/* Corridor band */
.band{position:relative;background:var(--spruce)}
.band img{width:100%;height:min(78vh,660px);object-fit:cover;object-position:center 30%;opacity:.92}
.band .cap{
  position:absolute;left:0;right:0;bottom:0;
  padding:120px clamp(20px,5vw,56px) 34px;
  background:linear-gradient(to top, rgba(20,24,20,.82), rgba(20,24,20,0));
  color:var(--bone);
}
.band .cap p{max-width:56ch;font-size:1.02rem}
.band .cap .kicker{color:#D89A7E;margin-bottom:.6rem}

/* Track record */
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:2.6rem}
@media(max-width:820px){.grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:520px){.grid{grid-template-columns:1fr}}
.grid figure{position:relative;overflow:hidden;background:#DDDACE}
.grid img{width:100%;aspect-ratio:4/3;object-fit:cover}
.grid figcaption{font-size:.8rem;font-style:italic;color:#6A695E;padding:9px 2px 0}

/* Team */
.team{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(24px,4vw,48px);margin-top:2.4rem}
@media(max-width:820px){.team{grid-template-columns:1fr;max-width:520px}}
.team img{width:132px;height:132px;object-fit:cover;border-radius:50%;filter:grayscale(12%)}
.team .ph{
  width:132px;height:132px;border-radius:50%;background:var(--spruce);color:var(--bone);
  display:flex;align-items:center;justify-content:center;
  font-family:'Libre Caslon Display',serif;font-size:2rem;
}
.team h3{font-size:1.25rem;margin:1.2rem 0 .2rem}
.team .role{font-style:italic;color:var(--brick);font-size:.95rem;margin-bottom:.8rem}
.team p{font-size:.95rem;color:#4C4B42}

/* Timeline */
.timeline{border-top:1px solid #D9D6CA;margin-top:1rem}
.trow{
  display:grid;grid-template-columns:190px 1fr;gap:clamp(20px,4vw,48px);
  padding:24px 0;border-bottom:1px solid #D9D6CA;
}
@media(max-width:700px){.trow{grid-template-columns:1fr;gap:4px}}
.trow .when{font-family:'Libre Caslon Display',serif;font-size:1.1rem;color:var(--brick)}
.trow p{font-size:1rem;color:#43423A;max-width:64ch}
.trow p b{font-weight:700}
.tfoot{font-style:italic;margin-top:1.8rem;color:#5D5C52}

/* Invitation */
.invite{background:var(--spruce);color:var(--bone);text-align:left}
.invite h2{max-width:20ch}
.invite p{max-width:56ch;color:#C8C7BB}
.btn{
  display:inline-block;margin-top:2.4rem;
  font-family:'Libre Caslon Text',serif;font-size:1rem;
  color:var(--bone);text-decoration:none;
  border:1px solid #6A755F;padding:15px 34px;
  transition:background .18s ease,border-color .18s ease;
}
.btn:hover{background:var(--pine);border-color:#8B977F}
.invite .alt{margin-top:1.6rem;font-size:.92rem;color:var(--stone)}
.invite .alt a{color:#D8B49F}

/* Footer */
footer{background:#1C221D;color:#8B8B80;padding:56px 0 64px;font-size:.83rem}
footer .frow{display:flex;justify-content:space-between;gap:40px;flex-wrap:wrap;margin-bottom:2.2rem}
footer .mark{font-family:'Libre Caslon Display',serif;font-size:1.1rem;color:#CDCCC0}
footer .legal{max-width:88ch;line-height:1.65}

:focus-visible{outline:2px solid var(--brick);outline-offset:3px}
@media (prefers-reduced-motion: reduce){html{scroll-behavior:auto}}
</style>
